# ---------------------------------------------------------------------------
# FosholLens Environment Variables
# Copy this file to .env (repo root) or apps/api/.env and fill in real values
# locally. NEVER commit .env.
#
# Every value here has a working default, so the file is optional. When neither
# GEMINI_API_KEY nor LLM_API_KEY is set, the API writes advice directly from
# the curated BARI/BRRI RAG corpus & knowledge base (generatedBy: "template").
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins (CORS).
# Production example: http://localhost:5173,https://foshollens.vercel.app
# (CORS_ORIGIN is also accepted as a backwards-compatible alias.)
CORS_ORIGINS=http://localhost:5173

# ---- LLM & Voice Question Understanding: Google Gemini Flash ----------------
# Primary key read by apps/api (LLM_API_KEY is also accepted as a Gemini key
# when LLM_PROVIDER=auto or gemini). Leave both empty for offline template mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional provider selector: auto (Gemini primary), gemini, or openai
LLM_PROVIDER=auto
LLM_BASE_URL=https://tokens.bd/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_TIMEOUT_MS=15000
LLM_MAX_CONCURRENCY=3

# Optional farmer voice/text question limits
MAX_QUESTION_CHARS=300
MAX_AUDIO_UPLOAD_BYTES=5242880
AUDIO_TRANSCRIPTION_TIMEOUT_MS=12000

# ---- Vision: local ONNX, CPU only ------------------------------------------
# EfficientNet-B0, 8 classes (potato_early_blight, potato_healthy,
# potato_late_blight, rice_bacterial_leaf_blight, rice_blast, rice_brown_spot,
# rice_healthy, rice_tungro). Committed at
# apps/api/models/foshollens_leaf.onnx (16 MB, ~40 ms).
VISION_ENABLED=true
VISION_MODEL_DIR=./models
VISION_CONFIDENCE_THRESHOLD=0.6
# Secondary acceptance path: a clear winner below the main threshold is still
# accepted when it beats the runner-up by this margin, clears the floor, and the
# photo is mostly the selected crop. Raise the margin/floor to refuse more.
VISION_MARGIN=0.30
VISION_MARGIN_FLOOR=0.45
VISION_MARGIN_MIN_CROP_MASS=0.70

# ---- TTS: local ONNX, CPU only --------------------------------------------
# Downloads once on first use (~300 MB peak RSS). Needs ffmpeg on PATH.
TTS_ENABLED=true
TTS_MODEL_ID=sulabhkatiyar/indic-tiny-tts-bengali
TTS_VOICE=female
TTS_FORMAT=mp3
FFMPEG_PATH=ffmpeg

# ---- Weather: Open-Meteo free tier, no key --------------------------------
# Note: the free tier is not licensed for commercial use.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_MINUTES=30
WEATHER_TIMEOUT_MS=4000

# ---- Storage ---------------------------------------------------------------
DATABASE_PATH=./storage/foshol-lens.db
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:4000
ANALYSIS_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Frontend - copy to apps/frontend/.env.local (or set in Vercel project env)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
