foshollens_model.zip

# The default vision checkpoint (EfficientNet-B0, 16 MB) is committed so a fresh
# clone runs with vision instead of silently reporting every photo as
# unidentified. The directory itself has to be re-included as well: git does not
# descend into an ignored directory, so a bare `!file` rule would not work.
# Everything else in models/ — experimental exports, other checkpoints — stays out.
!apps/api/models/
!apps/api/models/foshollens_leaf.onnx

# Hackathon submission form: contains teammates' personal contact details.
# Kept locally; must not land in a public repo.
docs/fosollesns.pdf

